  skos:prefLabel "Aesthetic" .

<http://ns.inria.fr/iadas/sport-vocab/Alpine%20skiing> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "Sportsdenature.gouv";
  skos:altLabel "skiing";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Technical>;
  skos:description "Discipline that consists of climbing a mountain to ski down it as quickly as possible. Alpine skiing comprises 6 events: downhill, super-G, giant slalom, slalom, alpine combined and team events. ";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Alpine skiing" .

<http://ns.inria.fr/iadas/sport-vocab/Anaerobic%20exercise> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "American College of Sports Medicine (2013)", "OMS 2021";
  skos:altLabel "gymgoer HIIT";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Power>;
  skos:description "Anaerobic exercise has been defined by the ACSM as intense physical activity of very short duration, fueled by the energy sources within the contracting muscles and independent of the use of inhaled oxygen as an energy source",
    "High-Intensity Interval Training (HIIT) is a physical training method alternating short bursts of intense effort with periods of recovery. ";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Anaerobic exercise" .

<http://ns.inria.fr/iadas/sport-vocab/Antigravitation> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  skos:altLabel "Anti-gravitational sports, gravitational", "Canoeing-kayaking";
  skos:inScheme iadascategory:Sport;
  skos:narrower <http://ns.inria.fr/iadas/sport-vocab/Canoing>, <http://ns.inria.fr/iadas/sport-vocab/Kayaking>,
    <http://ns.inria.fr/iadas/sport-vocab/Rock%20climbing>, <http://ns.inria.fr/iadas/sport-vocab/Ski%20jumping>,
    <http://ns.inria.fr/iadas/sport-vocab/Surf>;
  skos:prefLabel "Antigravitation" .

<http://ns.inria.fr/iadas/sport-vocab/Archery> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "World aquery federation";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Technical>;
  skos:description "Target archery is the discipline of shooting at stationary circular targets set at specific distances. The competition rounds at international events use the recognisable yellow, red, blue, black and white targets set at distances of 70 metres for recurve archers and 50 metres for compound archers. Other internationally recognised formats, like the 1440 Round, use distances of 90, 70, 60, 50 and 30 metres.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Archery" .

<http://ns.inria.fr/iadas/sport-vocab/Artistic%20gymnastic> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Gymnastics>;
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Artistic gymnastic" .

<http://ns.inria.fr/iadas/sport-vocab/Artistic%20swimming> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "Larousse";
  skos:altLabel "Synchronized swimming";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Aesthetic>;
  skos:description "A form of water ballet involving a series of figures that are judged and scored. An aquatic choreography is performed by a solo swimmer, a duo, or a team of up to eight swimmers, set to musical accompaniment, with the figures evaluated by official judges.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Artistic swimming" .

<http://ns.inria.fr/iadas/sport-vocab/Badminton> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "Sports.gouv";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Ball%20game>;
  skos:description "Racquet sport played between two players (singles) or two pairs (doubles) in two half-courts separated by a net. The players, known as badminton players, score points by hitting a shuttlecock with a racket into the opponent's court. The game ends as soon as the shuttlecock hits the ground or gets caught in the net.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Badminton" .

<http://ns.inria.fr/iadas/sport-vocab/Ball%20and%20team> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Other%20kind%20of%20sport%20categorisation;
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Sport-type%20grouping>;
  skos:description "Sport category comprising sports classified as ball games or team sports in the original studies";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Ball and team" .

