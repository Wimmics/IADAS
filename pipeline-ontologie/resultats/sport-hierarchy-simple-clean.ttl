iadascategory:Sport a skos:ConceptScheme;
  dcterms:created "2025-11-25"@en;
  dcterms:creator "Équipe de recherche IA-DAS"@en;
  dcterms:description "Tesaurus descriping sport cited on scientific papers"@en, "Thésaurus pour décrire les sports citées dans les articles"@fr;
  dcterms:title "IA-DAS - Sport thesaurus"@en, "IA-DAS - Thésaurus de sport"@fr;
  dcterms:version "1.0"@en .

<http://ns.inria.fr/iadas/sport-vocab/100%20meters> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "World athletics federation";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Power>;
  skos:description "Athletes stick to a lane and run down a straight 100m track, which is generally the straight section of a standard 400m track. Athletes start the race on blocks, which include sensors to detect false starts. The starting pistol is fired to signal the start of the race. Athletes then push off from the starting blocks by putting all their power into both legs. The fastest time wins the race and often places are separated by thousandths of a second. ";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "100 meters" .

<http://ns.inria.fr/iadas/sport-vocab/10000m> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "World athletics federation";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Endurance>;
  skos:description "The 10,000m is a long-distance running event that takes place on a standard 400m running track. Athletes complete 25 circuits of the track and the winner is the runner who crosses the finish line in the fastest time.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "10000m" .

<http://ns.inria.fr/iadas/sport-vocab/100m%20hurdles> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "World athletics federation";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Technical>;
  skos:description "The 100m hurdles is a women’s track and field event where athletes sprint over a series of 10 hurdles of 83,8cm (2ft 9in) set over a distance of 100m. The goal is to successfully clear the hurdles and cross the finish line in the fastest time.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "100m hurdles" .

<http://ns.inria.fr/iadas/sport-vocab/1500m> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "World athletics federation";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Endurance>;
  skos:description "The 1500m is the marquee middle-distance running event. Athletes compete by running three and three-quarters laps of a standard outdoor 400m track and the winner is the athlete who crosses the finish line first.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "1500m" .

<http://ns.inria.fr/iadas/sport-vocab/200%20meters> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "World athletics federation";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Power>;
  skos:description "The 200m sprint is a popular track and field event where athletes race around half of a standard 400m outdoor track.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "200 meters" .

<http://ns.inria.fr/iadas/sport-vocab/3000m> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "World athletics federation";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Endurance>;
  skos:description "Middle-distance running event that covers 7 and a half laps of a standard 400m track. The winner is the athletes who crosses the finish line in the fastest time. ";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "3000m" .

<http://ns.inria.fr/iadas/sport-vocab/400m%20hurdles> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "World athletics federation";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Technical>;
  skos:description "The 400m hurdles is a demanding short-distance track and field event where athletes race one lap of a standard 400m track. Throughout the lap, runners must jump cleanly over 10 hurdles that are spaced evenly apart.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "400m hurdles" .

<http://ns.inria.fr/iadas/sport-vocab/5000m> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "World athletics federation";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Endurance>;
  skos:description "The 5000m is a classic long-distance track and field event that covers 12-and-a-half laps of a standard 400m track. The winner is the athlete who crosses the finish line first.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "5000m" .

<http://ns.inria.fr/iadas/sport-vocab/Acrobatic%20gymnastic> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Gymnastics>;
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Acrobatic gymnastic" .

<http://ns.inria.fr/iadas/sport-vocab/Acrobatic%20skiing> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "Olympics.com";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Technical>;
  skos:description "A winter sport that combines traditional skiing with aerial acrobatics and high-speed tricks. Athletes perform jumps, spins and flips while hurtling down courses littered with obstacles such as moguls, ramps and halfpipes. It is also called freestyle skiing.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Acrobatic skiing" .

<http://ns.inria.fr/iadas/sport-vocab/Aerobic%20classes> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Fitness>;
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Aerobic classes" .

<http://ns.inria.fr/iadas/sport-vocab/Aerobic%20endurance%20training> a iadas:Sport,
    skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "American College of Sports Medicine (2021)";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Endurance>;
  skos:description "Refers to continuous and rhythmic physical activity that relies primarily on the aerobic energy system. It aims to improve the efficiency of the cardiovascular and respiratory systems in supplying oxygen to working muscles over extended periods.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Aerobic endurance training" .

<http://ns.inria.fr/iadas/sport-vocab/Aerobic%20gymnastic> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Gymnastics>;
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Aerobic gymnastic" .

<http://ns.inria.fr/iadas/sport-vocab/Aerobics> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Fitness>;
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Aerobics" .

