<http://ns.inria.fr/iadas/sport-vocab/Combat%20sports> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Other%20kind%20of%20sport%20categorisation;
  dcterms:source "(Barreira, 2017; Fuller, 1988; Moore et al., 2020; Valdés-Badilla et al., 2021, 2022)";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Combined>;
  skos:description "Represent athletic activities with specific rules involving fighting through striking, kicking and/or throwing, where the participants try to physically overcome the opponent while avoiding being overcome";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Combat sports" .

<http://ns.inria.fr/iadas/sport-vocab/Combined> a iadas:Sport, skos:Concept;
