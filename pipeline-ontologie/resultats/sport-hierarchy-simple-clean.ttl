<http://ns.inria.fr/iadas/sport-vocab/Baseball> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "French Baseball and Softball Federation";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Ball%20game>;
  skos:description """Sport that pits two teams of 5 players on a small field, with no specific equipment required: only a ball is necessary. A game is played
over 5 innings. The objective is to hit the ball, run the bases, and score points by returning to the starting point.""";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Baseball" .

<http://ns.inria.fr/iadas/sport-vocab/Basketball> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "Olympics.com";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Ball%20game>;
  skos:description "Team sport played on a rectangular court, in which two teams of five players play against each other and try to score by throwing the ball into the opponent's basket. ";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Basketball" .

<http://ns.inria.fr/iadas/sport-vocab/Beach%20volleyball> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "Fédération Française de Volley";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Ball%20game>;
  skos:description "Discipline in which two teams of two players compete on an outdoor sand court measuring 8x16m, separated by a net, with a ball that they throw back and forth using their hands or feet.  A match is played in 2 winning sets of 21 points (+ a tie-break of 15 points).";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Beach volleyball" .

<http://ns.inria.fr/iadas/sport-vocab/Biathlon> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "Sports.gouv";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Technical>;
  skos:description "Discipline combines cross-country skiing and rifle shooting (22 long rifle) at a distance of 50 metres in 2 different positions: prone and standing. ";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Biathlon" .

<http://ns.inria.fr/iadas/sport-vocab/Bocce> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "Federal Boccia Commission, French Federation";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Ball%20game>;
  skos:description "Precision sport intended for people with motor disabilities. It is played individually, in pairs, or in teams of 3. The court measures 12.5 by 6 meters, with a hard, smooth surface. Each team has 6 colored balls and attempts to place them as close as possible to a white ball called the \"jack\". The game is played over several rounds.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Bocce" .

<http://ns.inria.fr/iadas/sport-vocab/Bodybuilding> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "Dictionnaire l'internaute";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Aesthetic>;
  skos:description "Physical and sports activity aimed at developing muscle mass for aesthetic purposes.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Bodybuilding" .

<http://ns.inria.fr/iadas/sport-vocab/Boxing> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "Dicodusport";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Weight-sensitive>;
  skos:description "A combat sport in which two athletes, wearing protective gloves, punch each other in a boxing ring. Boxing is supervised by a referee over a series of one- to three-minute intervals called rounds. The result is decided when an opponent is deemed unable to continue by a referee, is disqualified for breaking a rule, gives up by throwing a towel, or is declared the winner or loser according to the judges' scorecards at the end of the contest.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Boxing" .

<http://ns.inria.fr/iadas/sport-vocab/Brazilian%20jiu-jitsu> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Martial%20arts>;
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Brazilian jiu-jitsu" .

<http://ns.inria.fr/iadas/sport-vocab/Canoing> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "Sportsdenature.gouv";
  skos:altLabel "Canoeing-kayaking";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Antigravitation>;
  skos:description "Sport practised from a boat propelled by a paddle, in calm water, at sea and in white water. ";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Canoing" .

<http://ns.inria.fr/iadas/sport-vocab/Cheerleading> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "Cambridge dictionary";
  skos:altLabel "Cheer/pom";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Aesthetic>;
  skos:description "Activity of leading the crowd in shouting encouragement and supporting a team at a sports event. The activity involves chanting, gymnastics, dance and teamwork.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Cheerleading" .

<http://ns.inria.fr/iadas/sport-vocab/Circus> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "Larousse", "Le dictionnaire", "Sports.gouv";
  skos:altLabel "Floor acrobatics";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Aesthetic>;
  skos:description "A set of exercises involving skill, strength, tricks, and training performed as a show.",
    "Artistic and physical practice that involves skillfully manipulating objects such as balls, clubs, or rings. It requires coordination, dexterity, and concentration, and is often performed solo or in groups as part of circus acts or street performances.",
    "It is a mix of acrobatics and choreographies performed individually and collectively to music. It is a physical activity similar to acrobatic gymnastics.",
    "The exercises of balance artists consist either in keeping their body still while positioned unstably, or in maintaining stable objects stacked in an apparently fragile manner. Includes events such as Rolla Bolla, balance ball, stilts, unicycles, slackline, and tightrope.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Circus" .

<http://ns.inria.fr/iadas/sport-vocab/Circus%20acrobatic> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Circus>;
