  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Competition%20status>;
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Competitive sport" .

<http://ns.inria.fr/iadas/sport-vocab/Crew> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "Larousse";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Technical>;
  skos:description "In rally or long-distance circuit racing, the group of drivers in a car or the group formed by the driver and the navigator responsible for guiding him.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Crew" .

<http://ns.inria.fr/iadas/sport-vocab/Cricket> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "Sports.gouv";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Ball%20game>;
  skos:description "Batting and ball sport played between two teams of 11 players. The game is played on a cricket pitch, with a 20-metre pitch in the centre. There are two wickets at either end of the pitch. Cricket is a popular game, the aim of which is to score the most runs.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Cricket" .

<http://ns.inria.fr/iadas/sport-vocab/Cross%20training> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "Cambridge dictionary", "Dictionnaire Lerobert";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Power>;
  skos:description "Exercise that makes your whole body stronger by combining several different activities",
    "Sporting activity combining gymnastics, weightlifting, and endurance";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Cross training" .

<http://ns.inria.fr/iadas/sport-vocab/Cross-country> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "World athletics federation";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Endurance>;
  skos:description "Races, for both teams and individuals, are run on either grass or woodland courses and might also include stretches of gravel paths, road and hills. Races usually take place in the winter months, outside the usual track and field season. The IAAF recommend for international competitions that there is a main course loop of between 1750m and 2000m with natural obstacles used where possible, and the likes of deep ditches, dangerous ascents and descents as well as thick undergrowth should be avoided.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Cross-country" .

<http://ns.inria.fr/iadas/sport-vocab/Cross-country%20skiing> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "Sportsdenature.gouv";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Technical>;
  skos:description "A cross-country sport involving skiing on hilly or flat slopes. The skis used are long, narrow, have no metal edges and are attached only to the front of the boot. Cross-country skis can be used in two ways: the traditional technique, known as the ‘classic’ or ‘alternating stride’, which consists of moving forward in two parallel tracks.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Cross-country skiing" .

<http://ns.inria.fr/iadas/sport-vocab/Crossfit> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Cross%20training>;
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Crossfit" .

<http://ns.inria.fr/iadas/sport-vocab/Cycling> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "Larousse";
  skos:altLabel "Biking";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Endurance>;
  skos:description "Any sporting activity performed on a bicycle, consisting of covering a certain distance.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Cycling" .

<http://ns.inria.fr/iadas/sport-vocab/Dance> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
  dcterms:source "Cambridge dictionary", "Dictionnaire l'internaute ", "Dictionnaire la langue Française",
    "Dictionnaire larousse ", "Fédération francaise de danse", "Keita, 1959. Le Courrier de l'UNESCO: une fenêtre ouverte sur le monde, XII, 1 ",
    "Larousse", "Larousse ", "Sports.gouv";
  skos:altLabel "Irish style";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Aesthetic>;
  skos:description "A rhythmic and energetic dance form from northern India. It represents a fusion of Hindu and Muslim cultures, characterized by powerful footwork.",
    "A type of dancing where carefully organized movements tell a story or express an idea, or a theatre work that uses this type of dancing: Dancers often wear elaborate costumes and pointe shoes, which allow them to dance on the tips of their toes.",
    "Choreographic composition design in which dance takes precedence over music and scenery.",
    "Dance based on the principle of turnout and the five positions of the feet and arms, which was taught in the classes of the Royal Academy of Dance.",
    "Dance combining rhythm and movement. Characterized by rites, magic, enchantment, exorcism, and the expression of freedom, morality, and various emotions. In Africa, no dance is performed without a specific purpose.",
    "Dance that emphasizes torso mobility, parallel feet, stylistic individuality, and improvisation, combining sensuality, acrobatics, and dynamic expressiveness.",
    "Hip-hop culture brings together graffiti, DJing, rap, and urban dances such as breakdance, locking, and popping.",
    "It is a blend of dance, theatre, and music, featuring narrative and scenic interpretation.",
    "It is a street dance practiced in the form of duels called battles, where dancers compete by performing sequences of footwork and floor moves.",
    "Spanish folk dance. It is a solo dance style characterized by its fusion with singing, hand clapping, and percussive footwork (similar to tap dancing). This dance can be accompanied by castanets. There is a traditional costume. For women, it consists of high-heeled shoes, a long, colorful dress (often red and black or white with polka dots) adorned with ruffles, as well as a fringed shawl. For men, it involves a short Andalusian suit.",
    "The activity of moving your feet and body to music.", "This dance is created based on classical dance, with added improvisation and freedom of movement for the dancer. It involves a strong connection to the floor and features an abstract form of storytelling.",
    "Traditional dance style from Ireland, characterized by quick footwork and a stiff upper body.",
    "Traditional folk dance, originating in rural or village contexts, passed down orally, resulting in variations depending on the region or performers.",
    "Type of dance in which the rhythm is kept by the noise of the dancer's shoes on the floor.";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Dance" .

<http://ns.inria.fr/iadas/sport-vocab/Dance%20African> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Categories%20defined%20by%20type%20of%20sport;
