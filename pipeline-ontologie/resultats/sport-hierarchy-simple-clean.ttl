    <http://ns.inria.fr/iadas/sport-vocab/Winter%20sports>;
  skos:prefLabel "Combined" .

<http://ns.inria.fr/iadas/sport-vocab/Competition%20status> a iadas:Sport, skos:Concept;
  iadas:sportCategory iadascategory:Other%20kind%20of%20sport%20categorisation;
  dcterms:source "Cambridge dictionary", "Office Québécois de la langue Française";
  skos:broader <http://ns.inria.fr/iadas/sport-vocab/Sport%20participation%20characteristics>;
  skos:description "A sport governed by official bodies and practiced in the form of competitions at various levels, where the competitor aims for maximum personal or absolute performance with a view to comparing performances",
    "Practice of sport or physical activity not involving competition";
  skos:inScheme iadascategory:Sport;
  skos:prefLabel "Competition status" .

<http://ns.inria.fr/iadas/sport-vocab/Competitive%20sport> a iadas:Sport, skos:Concept;
