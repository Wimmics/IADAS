# =============================================================================
# Enrichissement SKOS — Vocabulaire ACAD-vocab
# Auteure : Imane Amraoui — Stage IA-DAS, LAMHESS / Wimmics, Inria
# Date : Mai 2026
# Description : 157 concepts SKOS ajoutés au vocabulaire ACAD-vocab
#               Source originale : pipeline-ontologie/output/variable-hierarchy.ttl
# Chargement : ce fichier doit être chargé dans Fuseki après le pipeline RML
# =============================================================================

@prefix iadas-vocab: <http://ns.inria.fr/iadas/ACAD-vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# -----------------------------------------------------------------------------
# Déclaration formelle des 5 concepts racines (topConceptOf)
# Qualité SKOS : les concepts racines doivent déclarer leur appartenance au scheme
# -----------------------------------------------------------------------------
iadas-vocab:Variable skos:hasTopConcept
    iadas-vocab:DEAB ,
    iadas-vocab:Intrapersonal_factor_related_to_DEAB ,
    iadas-vocab:Interpersonal_factor_related_to_DEAB ,
    iadas-vocab:Other_behaviors ,
    iadas-vocab:Sociocultural_factor_related_to_DEAB .

iadas-vocab:DEAB skos:topConceptOf iadas-vocab:Variable .
iadas-vocab:Intrapersonal_factor_related_to_DEAB skos:topConceptOf iadas-vocab:Variable .
iadas-vocab:Interpersonal_factor_related_to_DEAB skos:topConceptOf iadas-vocab:Variable .
iadas-vocab:Other_behaviors skos:topConceptOf iadas-vocab:Variable .
iadas-vocab:Sociocultural_factor_related_to_DEAB skos:topConceptOf iadas-vocab:Variable .

iadas-vocab:Coach_leadership_style_negative_feedback a skos:Concept ;
    skos:broader iadas-vocab:Authority_and_Leadership_Styles ;
    skos:inScheme iadas-vocab:Variable ;
    skos:prefLabel "Coach leadership style negative feedback" .

iadas-vocab:Compulsive_spending a skos:Concept ;
    skos:broader iadas-vocab:Compulsive_and_behavioral_addictions ;
    skos:inScheme iadas-vocab:Variable ;
    skos:prefLabel "Compulsive spending" .

iadas-vocab:Diet a skos:Concept ;
    skos:broader iadas-vocab:Eating_behavior ;
    skos:inScheme iadas-vocab:ACAD-Vocabulary ;
    skos:prefLabel "Diet" .

iadas-vocab:Dietary a skos:Concept ;
    skos:broader iadas-vocab:Eating_behavior ;
    skos:inScheme iadas-vocab:ACAD-Vocabulary ;
    skos:prefLabel "Dietary" .

iadas-vocab:Dietary_restraint a skos:Concept ;
    skos:broader iadas-vocab:Restrictions ;
    skos:inScheme iadas-vocab:ACAD-Vocabulary ;
    skos:prefLabel "Dietary restraint" .

iadas-vocab:Disordered_eating_behavior a skos:Concept ;
    skos:broader iadas-vocab:Disordered_eating ;
    skos:inScheme iadas-vocab:ACAD-Vocabulary ;
    skos:prefLabel "Disordered eating behavior" .
# Categorie proposee par Amandine Daubresse le 17/07/2026 : DEAB > Disordered eating > Disordered eating behavior

iadas-vocab:Eating_pathology a skos:Concept ;
    skos:broader iadas-vocab:Eating_psychopathology ;
    skos:inScheme iadas-vocab:ACAD-Vocabulary ;
    skos:prefLabel "Eating pathology" .

iadas-vocab:Negative_reaction_to_imperfection a skos:Concept ;
    skos:broader iadas-vocab:Perfectionism ;
    skos:inScheme iadas-vocab:Variable ;
    skos:prefLabel "Negative reaction to imperfection" .

iadas-vocab:Orthorexic_eating_behavior a skos:Concept ;
    skos:broader iadas-vocab:Orthorexia ;
    skos:inScheme iadas-vocab:ACAD-Vocabulary ;
    skos:prefLabel "Orthorexic eating behavior" .

iadas-vocab:Physical_competence_evaluation a skos:Concept ;
    skos:broader iadas-vocab:Perceived_competence ;
    skos:inScheme iadas-vocab:Variable ;
    skos:prefLabel "Physical competence evaluation" .

iadas-vocab:Psychotic_disorder a skos:Concept ;
    skos:broader iadas-vocab:Psychological_symptoms ;
    skos:inScheme iadas-vocab:Variable ;
    skos:prefLabel "Psychotic disorder" .

iadas-vocab:Restrained_eating a skos:Concept ;
    skos:broader iadas-vocab:Restrictions ;
    skos:inScheme iadas-vocab:ACAD-Vocabulary ;
    skos:prefLabel "Restrained eating" .

iadas-vocab:Restrictive_eating a skos:Concept ;
    skos:broader iadas-vocab:Restrictions ;
    skos:inScheme iadas-vocab:ACAD-Vocabulary ;
    skos:prefLabel "Restrictive eating" .

iadas-vocab:Self-regulation_of_eating_attitude a skos:Concept ;
    skos:broader iadas-vocab:Emotion_regulation ;
    skos:inScheme iadas-vocab:Variable ;
    skos:prefLabel "Self-regulation of eating attitude" .

# =============================================================================
# Synonymes (skos:altLabel) — décisions encadrantes 27/06/2026
# Variables présentes dans la base sous un nom alternatif
# =============================================================================

# 1. "Coach leadership style negative feedback" est un synonyme de "Coach's negative feedback"
#    (confirmé par Meggy — présent colonne H dans Class_Hierarchy_VF_09avr26.xlsx)
<http://ns.inria.fr/iadas/ACAD-vocab/Coach%27s_negative_feedback>
    skos:altLabel "Coach leadership style negative feedback" .

# 2. "Compulsive spending" est un synonyme de "Compulsive buying"
#    (confirmé par Meggy — présent colonne H dans Class_Hierarchy_VF_09avr26.xlsx)
<http://ns.inria.fr/iadas/ACAD-vocab/Compulsive_buying>
    skos:altLabel "Compulsive spending" .

# 3. "Negative reaction to imperfection" (singulier) = "Negative reactions to imperfection" (pluriel)
<http://ns.inria.fr/iadas/ACAD-vocab/Negative_reactions_to_imperfection>
    skos:altLabel "Negative reaction to imperfection" .

# 4. "Psychotic disorder" (singulier) = "Psychotic disorders" (pluriel)
<http://ns.inria.fr/iadas/ACAD-vocab/Psychotic_disorders>
    skos:altLabel "Psychotic disorder" .

# 5. "Self-regulation of eating attitude" = synonyme de "Self-regulatory eating attitude in sport"
#    (ajouté par Amandine Daubresse le 27/06/2026)
<http://ns.inria.fr/iadas/ACAD-vocab/Self-regulatory_eating_attitude_in_sport>
    skos:altLabel "Self-regulation of eating attitude" .

# 6-10. Synonymes détectés par la page de validation (29/06/2026)

# 6. "Orthorexic eating behavior" = synonyme de "Orthorexic behavior"
<http://ns.inria.fr/iadas/ACAD-vocab/Orthorexic_behavior>
    skos:altLabel "Orthorexic eating behavior" .

# 7. "Restrictive eating" = synonyme de "Eating restriction"
#    (confirme par Amandine Daubresse le 17/07/2026 ; le rapprochement automatique du
#    29/06 pointait a tort vers "Restrictive eating behaviors", un concept voisin mais
#    different - "Eating restriction" liste explicitement "restrictive eating" dans sa
#    propre colonne Synonym du fichier VF officiel)
<http://ns.inria.fr/iadas/ACAD-vocab/Eating_restriction>
    skos:altLabel "Restrictive eating" .

# 8. "Eating pathology" = synonyme de "Eating psychopathology"
<http://ns.inria.fr/iadas/ACAD-vocab/Eating_psychopathology>
    skos:altLabel "Eating pathology" .

# 9. "Restrained eating" = synonyme de "Eating restriction"
#    (confirme par Amandine Daubresse le 17/07/2026 ; le rapprochement automatique du
#    29/06 pointait a tort vers "Behavioral restrained eating", un concept voisin mais
#    different)
<http://ns.inria.fr/iadas/ACAD-vocab/Eating_restriction>
    skos:altLabel "Restrained eating" .

# 10. "Dietary restraint" = synonyme de "Dieting"
#    (confirme par Amandine Daubresse le 17/07/2026 ; le rapprochement automatique du
#    29/06 pointait a tort vers "Behavioral restrained eating")
<http://ns.inria.fr/iadas/ACAD-vocab/Dieting>
    skos:altLabel "Dietary restraint" .

# 11. "Dietary" = synonyme de "Dieting" (confirmé par Amandine Daubresse — 30/06/2026)
<http://ns.inria.fr/iadas/ACAD-vocab/Dieting>
    skos:altLabel "Dietary" .

# 12. "Diet" = synonyme de "Dieting" (confirmé par Amandine Daubresse — 30/06/2026)
<http://ns.inria.fr/iadas/ACAD-vocab/Dieting>
    skos:altLabel "Diet" .

# 13. "Physical competence evaluation" = synonyme de "Perceived physical ability"
#     (confirmé par Meggy Hayotte — colonne H Class-Hierarchy-V1.csv — 30/06/2026)
<http://ns.inria.fr/iadas/ACAD-vocab/Perceived_physical_ability>
    skos:altLabel "Physical competence evaluation" .
