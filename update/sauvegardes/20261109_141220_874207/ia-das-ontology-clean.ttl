  iadas:perspectives "Allow a certain percentage of the participants body mass to be dieted ahead of the competition. Include pre measuring of athletes usual weight and locate them into a natural weight class or for MMA organizations to adopt the weight in rules of jiu jitsu. ";
  iadas:relationDegree "r=-.04, N.S.";
  iadas:relationDirection "NS";
  iadas:sampleSizeMobilized "64 Brazilian jiu-jitsu";
  iadas:sportPracticeType "Individual sport";
  iadas:sportSubcategory "Weight sensitive";
  iadas:typeOfAnalysis "Correlation" .

