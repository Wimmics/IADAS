<http://ns.inria.fr/iadas/data/Analysis_2037> a iadas:Analysis;
  iadas:analysisId "2037";
  iadas:authorConclusion "The current study identified athletes desire to lose weight as an independent predictor of disordered eating Our study has identified emotional regulation as a promising predictor of disordered eating. ";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_2037>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_2037>;
  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/Soccer>, <http://ns.inria.fr/iadas/sport-vocab/basketball>,
    <http://ns.inria.fr/iadas/sport-vocab/cheer>, <http://ns.inria.fr/iadas/sport-vocab/cross%20country>,
    <http://ns.inria.fr/iadas/sport-vocab/equestrian>, <http://ns.inria.fr/iadas/sport-vocab/golf>,
    <http://ns.inria.fr/iadas/sport-vocab/pom>, <http://ns.inria.fr/iadas/sport-vocab/softball>,
    <http://ns.inria.fr/iadas/sport-vocab/tennis>, <http://ns.inria.fr/iadas/sport-vocab/track%20and%20field>;
  iadas:limites "We used a convenience sample of Female college athletes without nonathlete controls in the sample, the finding cannot be generalized. Geographical, cultural, ethnic and other differences were not accounted for in our study. Some eligible athletes mau have had a known eating disorder and thus might have opted out of study participation, thus influencing the final results. Disordered eating were self reported. Athletes may have underreported their actual eating behaviors due to social desirability or other influences. ";
  iadas:numberOfSportStudied "Multiple";
  iadas:perspectives "Future studies should investigate indivdiual dimensions of emotional regulation and body dissatisfaction and their relationship to disordered eating symptoms in representative samples of college Female athletes, including further investigation of potential diffrences between weight sensitive and less weight sensitive sports. ";
  iadas:relationDegree "r=.72, p<.001";
  iadas:relationDirection "+";
  iadas:sampleSizeMobilized "151";
  iadas:sportPracticeType "Mixed sport";
  iadas:sportSubcategory "Multisport ";
  iadas:typeOfAnalysis "Pearson correlation" .

