  iadas:analysisId "1328";
  iadas:authorConclusion "Regression analyses for females revealed that body dissatisfaction was the most strongly related variable to disordered eating behaviors, followed by self esteem and type of sport. The regression analysis revealed that for males, body dissatisfaction was the only variable that related to disordered eating behavior. ";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_1328>;
