<http://ns.inria.fr/iadas/data/Analysis_949> a iadas:Analysis;
  iadas:analysisId "949";
  iadas:authorConclusion "After controlling for social desirability effects, negative perfectionism scores were found to correlate positively with disturbed eating attitudes scores, whereas positive perfectionism scores were found to be unrelated to disturbed eating attitude scores. ";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_949>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_949>;
  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/Heavyweight>, <http://ns.inria.fr/iadas/sport-vocab/lightweight%20rowing>;
  iadas:limites "Focus only on rowing sample. ";
  iadas:numberOfSportStudied "One";
  iadas:perspectives """This would suggest that resiliency against unhealthy eating could be increased by teaching athletes how to develop and maintain high levels of positive perfectionism. Intervention with goal in mind is a worthy topic for future research. 
Do these perfectionistic tendencies change throughout an athlete's career ? How and why do these changes occur ? What implications do these changes have on eating attitude ?""";
  iadas:relationDegree " r=-.17, p<.01";
  iadas:relationDirection "-";
  iadas:sampleSizeMobilized "496";
  iadas:sportPracticeType "Individual sport";
  iadas:sportSubcategory "Endurance";
  iadas:typeOfAnalysis "Bivariate correlation" .

