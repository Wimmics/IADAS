  iadas:hasStatistics <http://ns.inria.fr/iadas/data/AgeStats_1879>, <http://ns.inria.fr/iadas/data/BmiStats_1879>,
    <http://ns.inria.fr/iadas/data/ExFreqStats_1879>, <http://ns.inria.fr/iadas/data/ExpStats_1879>;
