<http://ns.inria.fr/iadas/data/Analysis_114> a iadas:Analysis;
  iadas:analysisId "114";
  iadas:authorConclusion "This study highlights a higher risk of orthorexia nervosa (OrNe) among male students, with strong associations with dieting behaviors and, in females, BMI. It emphasizes the multifactorial nature of OrNe and the importance of early identification in young athletes.";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_114>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_114>;
  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/Badminton>, <http://ns.inria.fr/iadas/sport-vocab/basketball>,
    <http://ns.inria.fr/iadas/sport-vocab/football>, <http://ns.inria.fr/iadas/sport-vocab/other%20sport>,
    <http://ns.inria.fr/iadas/sport-vocab/swimming>, <http://ns.inria.fr/iadas/sport-vocab/volleyball>,
    <http://ns.inria.fr/iadas/sport-vocab/weightlifting>;
  iadas:limites "The cross-sectional design limits causal inference, and self-reported measures may introduce bias. Additionally, mental health assessment tools and limited comparability with prior studies restrict interpretation.";
  iadas:numberOfSportStudied "Multiple";
  iadas:perspectives "Future research should include longitudinal designs, more diverse populations, and more specific mental health measures. Preventive strategies targeting dietary behaviors and body-related factors in university and sports settings are needed.";
  iadas:relationDegree "r=-.040, p=.663";
  iadas:relationDirection "NS";
  iadas:sampleSizeMobilized "124";
  iadas:sportPracticeType "Mixed sport";
  iadas:sportSubcategory "Multisport";
  iadas:typeOfAnalysis "Pearson correlation" .

