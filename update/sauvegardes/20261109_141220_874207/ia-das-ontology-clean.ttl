  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_1454>;
  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/gymnastics>;
  iadas:limites "The reliability of the use of self reported instruments in athletes and the cross sectional design, due to the inability to infer causality. MPS was originally validated for students aged 17-51 years and, in this research, this instrument was applied to adolescents from 10 years. The imbalance between the number of girls and boys evaluated among athletes should be emphasized. ";
  iadas:numberOfSportStudied "One";
  iadas:perspectives "Further studies should assess genders separately, and longitudinal studies should be conducted with athletes, as psychological factors may change depending on the competitive period. ";
  iadas:relationDegree "r=.182, p=N.S.";
  iadas:relationDirection "NS";
  iadas:sampleSizeMobilized "40";
  iadas:sportPracticeType "Individual sport";
  iadas:sportSubcategory "Aesthetic";
  iadas:typeOfAnalysis "Pearson correlation" .

