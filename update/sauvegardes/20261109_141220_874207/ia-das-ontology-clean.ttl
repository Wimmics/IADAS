<http://ns.inria.fr/iadas/data/Analysis_308> a iadas:Analysis;
  iadas:analysisId "308";
  iadas:authorConclusion "Problematic eating behaviors in athletes were low, but meaningfully correlated with self-reported depression for both Female and male. However sex appeared to moderate the present values such that problematic eating patterns and depressive symptoms were positively related for Female, whereas these variables were negatively related for male. ";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_308>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_308>;
  iadas:limites "The current study is limited by a small sample size and the absence of information on team membership. ";
  iadas:numberOfSportStudied "Multiple";
  iadas:perspectives "Studies of larger sample size and absence of information on team membership would be helpful to elucidate the association between problematic eating patterns and depressive symptoms in specific sports. ";
  iadas:relationDegree "r=.25, p>.05";
  iadas:relationDirection "NS";
  iadas:sampleSizeMobilized "57";
  iadas:sportPracticeType "Mixed sport";
  iadas:sportSubcategory "Multisport ";
  iadas:typeOfAnalysis "Correlation" .

