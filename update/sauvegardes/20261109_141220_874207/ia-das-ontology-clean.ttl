<http://ns.inria.fr/iadas/data/Analysis_1191> a iadas:Analysis;
  iadas:analysisId "1191";
  iadas:authorConclusion "Unhealthy eating behavior is significantly related to rigorous self perception. ";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_1191>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_1191>;
  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/Ballet>, <http://ns.inria.fr/iadas/sport-vocab/gymnastics>;
  iadas:limites "The small size of the BGA group. Modification of the ARS questionnaire, which was adapted to the needs of the study of girls aged 10-12. ";
  iadas:numberOfSportStudied "Multiple";
  iadas:perspectives "Our results indicate the need for early nutritional or dietary intervention in the group of 10-12 year old young ballet dancers and artistic gymnasts, including nutritional education, e.g. in terms of consuming an appropriate number of meals during the day, the role of individual nutrients, the harmfulness of fasting and taking slimming. The intervention should also include psychological care in order to raise self-esteem, which affects eating behavior, health and job satisfaction. ";
  iadas:relationDegree "r=.42, p<.001";
  iadas:relationDirection "+";
  iadas:sampleSizeMobilized "120";
  iadas:sportPracticeType "Individual sport";
  iadas:sportSubcategory "Aesthetic";
  iadas:typeOfAnalysis "Correlation" .

<http://ns.inria.fr/iadas/data/Analysis_1192> a iadas:Analysis;
  iadas:analysisId "1192";
  iadas:authorConclusion "Muscularity-oriented eating behaviours, muscle dysmorphia, and exercise addiction are strongly interconnected in men, with sexual orientation intensifying these relationships, particularly among gay men. Findings highlight the need for integrated and identity-sensitive assessment and treatment approaches";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_1192>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_1192>;
  iadas:limites "The cross-sectional design, reliance on self-report, exclusion of bisexual/fluid individuals, and lack of key variables (e.g., minority stress) limit causal interpretation and generalizability";
  iadas:numberOfSportStudied "Multiple";
  iadas:perspectives "Future studies should use longitudinal and more inclusive designs, and directly assess underlying mechanisms (e.g., stigma, body surveillance) to better understand and target these interconnected issues";
  iadas:relationDegree "r=.57, p<.01";
  iadas:relationDirection "+";
  iadas:sampleSizeMobilized "168";
  iadas:sportPracticeType "Mixed sport";
  iadas:sportSubcategory "Multisport";
  iadas:typeOfAnalysis "Pearson correlation" .

