<http://ns.inria.fr/iadas/data/Analysis_280> a iadas:Analysis;
  iadas:analysisId "280";
  iadas:authorConclusion "Despite great attention paid to fitness, health, conditioning and skill, participants in this study still were largely dissatisfied with their body shape and size. ";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_280>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_280>;
