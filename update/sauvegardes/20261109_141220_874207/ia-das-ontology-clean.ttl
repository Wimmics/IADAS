<http://ns.inria.fr/iadas/data/Analysis_2298> a iadas:Analysis;
  iadas:analysisId "2298";
  iadas:authorConclusion "This study has extended prior work by investigating the role of exercise motives in the link between low body esteem and eating disorder symptomatology. ";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_2298>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_2298>;
  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/Fitness>;
  iadas:limites "Cross sectional design does not allow any conclusions about the direction of causality of the variables. The small sample size. The procedure employed may have led to a selective sample. Results are limited in generalizability as they can be applied only to women who regularly exercise in a fitness center. ";
  iadas:numberOfSportStudied "One";
  iadas:perspectives "Future research is needed to examine current research topic in populations of exercisers other than fitness club members. Future research should replicate results in males, and people involved in other sports than aerobics. Future research should examine other reasons for exercise such as obsessivity-compulsivity. ";
  iadas:relationDegree "r=.48, p<.01";
  iadas:relationDirection "+";
  iadas:sampleSizeMobilized "81";
  iadas:sportPracticeType "Individual sport";
  iadas:sportSubcategory "Aesthetic";
  iadas:typeOfAnalysis "Correlation" .

<http://ns.inria.fr/iadas/data/Analysis_2299> a iadas:Analysis;
  iadas:analysisId "2299";
  iadas:authorConclusion "This study has extended prior work by investigating the role of exercise motives in the link between low body esteem and eating disorder symptomatology. ";
  iadas:complexityOfAnalysis "Simple analyses";
