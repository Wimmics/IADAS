<http://ns.inria.fr/iadas/data/Analysis_2206> a iadas:Analysis;
  iadas:analysisId "2206";
  iadas:authorConclusion "The study supports the Tripartite Model in athletes, showing that sociocultural pressures—especially media, family, and teammates—contribute to disordered eating through internalization of ideals and appearance comparison. It highlights the continued importance of both general and sport-specific influences on athletes’ eating behaviors";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_2206>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_2206>;
  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/Cross-country>, <http://ns.inria.fr/iadas/sport-vocab/baseball>,
    <http://ns.inria.fr/iadas/sport-vocab/basketball>, <http://ns.inria.fr/iadas/sport-vocab/cheerleading>,
    <http://ns.inria.fr/iadas/sport-vocab/dancing>, <http://ns.inria.fr/iadas/sport-vocab/football>,
    <http://ns.inria.fr/iadas/sport-vocab/lacrosse>, <http://ns.inria.fr/iadas/sport-vocab/other>,
    <http://ns.inria.fr/iadas/sport-vocab/running>, <http://ns.inria.fr/iadas/sport-vocab/soccer>,
    <http://ns.inria.fr/iadas/sport-vocab/softball>, <http://ns.inria.fr/iadas/sport-vocab/swimming>,
    <http://ns.inria.fr/iadas/sport-vocab/tennis>, <http://ns.inria.fr/iadas/sport-vocab/track%20and%20field>,
    <http://ns.inria.fr/iadas/sport-vocab/volleyball>;
  iadas:limites "Key limitations include the use of non-validated measures for some pressures, reliance on self-report data, and insufficient power to test differences across gender or sport types. Additionally, the cross-sectional design prevents conclusions about causality";
  iadas:numberOfSportStudied "Multiple";
  iadas:perspectives "Future research should use longitudinal and more nuanced methods to explore gender, sport-specific contexts, and social dynamics. These insights could help design targeted prevention and intervention programs tailored to athletes’ unique sociocultural environments";
  iadas:relationDegree "r=.31, p<.01";
  iadas:relationDirection "+";
  iadas:sampleSizeMobilized "244";
  iadas:sportPracticeType "Mixed sport";
  iadas:sportSubcategory "Multisport";
  iadas:typeOfAnalysis "Pearson correlation" .

