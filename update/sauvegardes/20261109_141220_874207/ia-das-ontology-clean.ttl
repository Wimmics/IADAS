  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/Rhythmic%20gymnastics>, <http://ns.inria.fr/iadas/sport-vocab/junior%20synchronized%20swimming>,
    <http://ns.inria.fr/iadas/sport-vocab/rowers>, <http://ns.inria.fr/iadas/sport-vocab/running%20%28long%20distance-%20above%20800m%29>,
    <http://ns.inria.fr/iadas/sport-vocab/running%20%28middle%29>, <http://ns.inria.fr/iadas/sport-vocab/senior%20synchronized%20swimming>,
    <http://ns.inria.fr/iadas/sport-vocab/university%20athletes>;
  iadas:limites "N.A.";
  iadas:numberOfSportStudied "Multiple";
  iadas:perspectives "It is recommaleded that coaches and family members work mainly with beginning teams that do not exert pressure on athletes in relation to body weight or ideal body image for their sport. Hence, it is imperative that athletes of differents sports consult with doctors, nutritionists, psychologists, and exercise physiologists to help preserve the athletes health and promote a longer and healthier athletic performance. ";
  iadas:relationDegree "r=.48, p<.05";
