<http://ns.inria.fr/iadas/data/Analysis_1067> a iadas:Analysis;
  iadas:analysisId "1067";
  iadas:authorConclusion "The athletic body image strongly contributed to ED. The athletes self-evaluations about shape, weight and fat percentage and the perceived opinions of others on these aspects appeared to be only significant factors uniquely explaining 14 and 9% of the EDE-Q variance. 64% of the variance was explained by the relevant body image components from daily life and sport. ";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_1067>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_1067>;
