<http://ns.inria.fr/iadas/data/Analysis_2338> a iadas:Analysis;
  iadas:analysisId "2338";
  iadas:authorConclusion "Overconcern with body size was a primary and strong mediator of other risk factors for developing eating disorder symptoms. Risk factors that were mediated by overconcern with body size were: social influence for thinness, anxiety about athletic performance, and negative appraisal of athletic achievement. These risk factors were not strongly predictive of eating disorder symptoms without mediation through overconcern with body size. ";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_2338>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_2338>;
  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/Swimmers>, <http://ns.inria.fr/iadas/sport-vocab/basketball>,
    <http://ns.inria.fr/iadas/sport-vocab/cheerleading>, <http://ns.inria.fr/iadas/sport-vocab/dance>,
    <http://ns.inria.fr/iadas/sport-vocab/gymnastics>, <http://ns.inria.fr/iadas/sport-vocab/tennis>,
    <http://ns.inria.fr/iadas/sport-vocab/track>, <http://ns.inria.fr/iadas/sport-vocab/volleyball>;
  iadas:limites "N.A.";
  iadas:numberOfSportStudied "Multiple";
  iadas:perspectives "N.A.";
  iadas:relationDegree "r=.278, p<.05";
  iadas:relationDirection "+";
  iadas:sampleSizeMobilized "98";
  iadas:sportPracticeType "Mixed sport";
  iadas:sportSubcategory "Multisport ";
  iadas:typeOfAnalysis "Correlation" .

