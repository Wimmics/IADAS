<http://ns.inria.fr/iadas/data/Analysis_593> a iadas:Analysis;
  iadas:analysisId "593";
  iadas:authorConclusion "This study provided an initial foundation of data on body checking and body avoidance among dancers, aspects of ED pathology that feature prominenly in evidence-based assessments and treatments and that may be an important target in dancer-specific ED interventions. ";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_593>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_593>;
  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/Dance%20%28ballet%29>, <http://ns.inria.fr/iadas/sport-vocab/Dance%20%28contemporary%20ballet%29>,
    <http://ns.inria.fr/iadas/sport-vocab/Dance%20%28contemporary%29>, <http://ns.inria.fr/iadas/sport-vocab/Dance%20%28hip%20hop%29>,
    <http://ns.inria.fr/iadas/sport-vocab/Dance%20%28jazz%29>, <http://ns.inria.fr/iadas/sport-vocab/Dance%20%28modern%29>,
    <http://ns.inria.fr/iadas/sport-vocab/Dance%20%28musical%20theatre%29>;
  iadas:limites "Small sample size which may have attenuated findings and constrained analyses. Restrospective self-report data may have compromised accuracy in participant's reporting. The body checking and avoidance used in the current study were originally validated in women. This study did not include an existing body checking questionnaire developed for males. ";
  iadas:numberOfSportStudied "One";
  iadas:perspectives "Future research involving larger samples, focus groups, cognitive interviewing and experimental and longitudinal methodologies should continue to grow the field awareness of the diverse ways in which ED pathology presents among dancers and the corresponding development of targeted asssessment and intervention for thin at-risk group.";
  iadas:relationDegree "r=.68, p<.05";
  iadas:relationDirection "+";
  iadas:sampleSizeMobilized "80";
  iadas:sportPracticeType "Individual sport";
  iadas:sportSubcategory "Aesthetic";
  iadas:typeOfAnalysis "Pearson correlation" .

