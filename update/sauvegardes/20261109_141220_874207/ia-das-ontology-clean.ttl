  iadas:sampleSizeMobilized "148";
  iadas:sportPracticeType "Mixed sport";
  iadas:sportSubcategory "Multisport";
  iadas:typeOfAnalysis "Pearson correlation" .

<http://ns.inria.fr/iadas/data/Analysis_1202> a iadas:Analysis;
  iadas:analysisId "1202";
  iadas:authorConclusion "The mediating variable of body hsape was necessary to etablish the association between abnormal eating attitudes and exercise addiction. The association between body shape and eating disorders has already been etablished. ";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_1202>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_1202>;
  iadas:limites "This study compare different types of physical exercise such as amateur versus professional sports and individual versus group sports. Due to a small number of addicted individuals in each cohort, the differences were marginal non significant. ";
  iadas:numberOfSportStudied "Multiple";
  iadas:perspectives "The variable of body shape has been etablished as playing an important role in both eating disorders and physical exercise, further studies need to etablish and validate this connection. ";
  iadas:relationDegree "r=.66, p=.15";
  iadas:relationDirection "NS";
  iadas:sampleSizeMobilized "100";
  iadas:sportPracticeType "Mixed sport";
  iadas:sportSubcategory "Multisport ";
  iadas:typeOfAnalysis "Correlation" .

