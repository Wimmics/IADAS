<http://ns.inria.fr/iadas/data/Analysis_679> a iadas:Analysis;
  iadas:analysisId "679";
  iadas:authorConclusion "Disordered eating did not improve performance over time but was associated with poorer performance and increased injury-related absence, particularly over 6 months. This highlights its negative impact on athletes’ health and participation";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_679>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_679>;
  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/Lean%20sport>, <http://ns.inria.fr/iadas/sport-vocab/aesthetic%20sport>,
    <http://ns.inria.fr/iadas/sport-vocab/anti-gravitational%20sports>, <http://ns.inria.fr/iadas/sport-vocab/endurance%20sport>,
    <http://ns.inria.fr/iadas/sport-vocab/weight-class%20sport>;
  iadas:limites "The study relied on self-reported measures of performance and injury, which may be biased, and used a specific sample with limited diversity, affecting generalizability";
  iadas:numberOfSportStudied "Multiple";
  iadas:perspectives "Future research should use more objective performance and injury measures, examine longer timeframes, and include more diverse athlete populations to better understand underlying mechanisms";
  iadas:relationDegree "r=-.29, p<.001";
  iadas:relationDirection "-";
  iadas:sampleSizeMobilized "178";
  iadas:sportPracticeType "Mixed sport";
  iadas:sportSubcategory "Multisport";
  iadas:typeOfAnalysis "Pearson correlation" .

