<http://ns.inria.fr/iadas/data/Analysis_746> a iadas:Analysis;
  iadas:analysisId "746";
  iadas:authorConclusion "Parental influences are predictors of low self-esteem and DE only among elite athletes. Body image dissatisfaction corresponds to the strongest predictor of DE in elite athletes but not for non elite athletes. Self esteem was not a predictor of DE in elite athletes, in contrast to the other two groups. ";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_746>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_746>;
  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/Dance>, <http://ns.inria.fr/iadas/sport-vocab/gymnastics>;
  iadas:limites "Minimum criteria to undertake structural equation models, the small number of male athletes may have skewed the results. The cross sectional design of this study does not permit causal inference. ";
  iadas:numberOfSportStudied "Multiple";
  iadas:perspectives "Future studies should test the same models with different samples of male and Female athletes to determine the generazibility of these findings. A clinical evaluation of adolescents who reported disordered eating is needed to examine the prevalence of true eating disorders, especially among athletes. ";
  iadas:relationDegree "r=.85, p<.05";
  iadas:relationDirection "+";
  iadas:sampleSizeMobilized "725";
  iadas:sportPracticeType "Individual sport";
  iadas:sportSubcategory "Aesthetic";
  iadas:typeOfAnalysis "Correlation" .

