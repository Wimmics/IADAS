<http://ns.inria.fr/iadas/data/Analysis_1283> a iadas:Analysis;
  iadas:analysisId "1283";
  iadas:authorConclusion "Several factors identified in this study (e.g., athlete status, perfectionism) appear to play a role in the development of ED in this population. The study of other factors such as athletic identity and the coach-athlete relationship could provide insight into the development of ED symptoms within this group of athletes. ";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_1283>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_1283>;
