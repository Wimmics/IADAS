<http://ns.inria.fr/iadas/data/Analysis_2024> a iadas:Analysis;
  iadas:analysisId "2024";
  iadas:authorConclusion "Depressive symptoms did not predict athletes eating psychopathology. The present stuy did not find direct prospective relations from depressive symptoms to eating disordered symptoms. ";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_2024>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_2024>;
  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/Swimming>, <http://ns.inria.fr/iadas/sport-vocab/cycling>,
    <http://ns.inria.fr/iadas/sport-vocab/football>, <http://ns.inria.fr/iadas/sport-vocab/hockey>,
    <http://ns.inria.fr/iadas/sport-vocab/judo>, <http://ns.inria.fr/iadas/sport-vocab/rugby>;
  iadas:limites "Methodological issues pertaining to the use of self report measures, a small sample composed largely of Caucasian Female athletes and the use of parametric methods to analyse nonparametric data. Athletes scores on both measures were relatively healthy. It is not possible to make definitive conclusions about causality, as the findings are essentially correlational. ";
  iadas:numberOfSportStudied "Multiple";
  iadas:perspectives """Future studies should aim to replicate and confirm the present findings using experimental designs as this is considered the next step in identifying true causal risk factors. 
Studies should seek to explore the prevalence of eating disordered, depressive and comorbidity symptoms in athletes as well as determine the factors that are unique to eating disorders and depression and those that are shared by both disorders. """;
  iadas:relationDegree " r=.42, p<.001";
  iadas:relationDirection "+";
  iadas:sampleSizeMobilized "122";
  iadas:sportPracticeType "Mixed sport";
  iadas:sportSubcategory "Multisport ";
  iadas:typeOfAnalysis "Spearman correlation" .

