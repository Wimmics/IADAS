<http://ns.inria.fr/iadas/data/Analysis_213> a iadas:Analysis;
  iadas:analysisId "213";
  iadas:authorConclusion "This study shows that disordered eating is significantly associated with lower HRQOL in adolescent athletes, even at subclinical levels, particularly affecting psychosocial functioning. Female athletes appear more vulnerable to reduced HRQOL.";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_213>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_213>;
  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/Football>, <http://ns.inria.fr/iadas/sport-vocab/Soccer>,
    <http://ns.inria.fr/iadas/sport-vocab/Swimming>, <http://ns.inria.fr/iadas/sport-vocab/baseball>,
    <http://ns.inria.fr/iadas/sport-vocab/basketball>, <http://ns.inria.fr/iadas/sport-vocab/cross%20country>,
    <http://ns.inria.fr/iadas/sport-vocab/dance>, <http://ns.inria.fr/iadas/sport-vocab/diving>,
    <http://ns.inria.fr/iadas/sport-vocab/ice%20hockey>, <http://ns.inria.fr/iadas/sport-vocab/lacrosse>,
    <http://ns.inria.fr/iadas/sport-vocab/softball>, <http://ns.inria.fr/iadas/sport-vocab/tennis>,
    <http://ns.inria.fr/iadas/sport-vocab/track%20and%20field>, <http://ns.inria.fr/iadas/sport-vocab/volleyball>;
  iadas:limites "Methodological challenges in measuring energy availability, reliance on self-reported data, and limited generalizability (single region, sport dominance, no control group) may affect the findings.";
  iadas:numberOfSportStudied "Multiple";
  iadas:perspectives "Future studies should explore mediating factors and better assess energy availability and symptoms. Early screening and targeted interventions are essential to improve HRQOL in young athletes.";
  iadas:relationDegree "r=-.13, p=.31";
  iadas:relationDirection "NS";
  iadas:sampleSizeMobilized "64";
  iadas:sportPracticeType "Mixed sport";
  iadas:sportSubcategory "Multisport";
  iadas:typeOfAnalysis "Pearson correlation" .

