  iadas:analysisId "487";
  iadas:authorConclusion "This study shows that negative coaching styles are associated with disordered eating through increased self-criticism, while positive leadership styles help reduce self-criticism. It highlights self-criticism as a key psychological mechanism linking coaching behaviors to eating pathology.";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_487>;
