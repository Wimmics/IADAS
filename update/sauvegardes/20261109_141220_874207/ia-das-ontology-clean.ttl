<http://ns.inria.fr/iadas/data/Analysis_751> a iadas:Analysis;
  iadas:analysisId "751";
  iadas:authorConclusion "Adolescents sex and BMI were significant predictors of disordered eating for both athletes. Parental influences emerged as the only family variable that predicted athletes disordered eating. ";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_751>;
