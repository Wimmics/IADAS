<http://ns.inria.fr/iadas/data/Analysis_186> a iadas:Analysis;
  iadas:analysisId "186";
  iadas:authorConclusion "Appearance and performance related BD significantly relate to ED symptoms among Female but not male. ";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_186>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_186>;
  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/10k>, <http://ns.inria.fr/iadas/sport-vocab/5%20kilometer>,
    <http://ns.inria.fr/iadas/sport-vocab/full%20marathon>, <http://ns.inria.fr/iadas/sport-vocab/half%20marathon>;
  iadas:limites "Generalization of findings to other populations may be limited (sample comprised predominantly healthy adult runners with low ED symptomatology). BD reported by runners may not generalize to other types of athletes, due to varying anthropometric ideals and demographic profiles. ";
  iadas:numberOfSportStudied "Multiple";
  iadas:perspectives "Additional data is needed to validate the context-specific body dissatisfaction (BD) constructs. Eating disorder (ED) assessment and prevention efforts for athletes should address performance-related BD in addition to the more commonly assessed appearance-related BD. Future research should aim to identify the nuances of BD, explore how BD constructs vary across different athletic contexts, and define individual differences that may help improve the assessment of ED risk among athletes.";
  iadas:relationDegree " r=.39, p<.05";
  iadas:relationDirection "+";
  iadas:sampleSizeMobilized "216";
  iadas:sportPracticeType "Individual sport";
  iadas:sportSubcategory "Endurance";
  iadas:typeOfAnalysis "Pearson correlation " .

