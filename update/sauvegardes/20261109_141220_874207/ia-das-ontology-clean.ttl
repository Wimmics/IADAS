<http://ns.inria.fr/iadas/data/Analysis_311> a iadas:Analysis;
  iadas:analysisId "311";
  iadas:authorConclusion "This study found significant correlations between LEA risk, DE, triad risk, perfectionism and time spent in a program for female NCAA division I athletes";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_311>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_311>;
  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/Cross%20country>, <http://ns.inria.fr/iadas/sport-vocab/soccer>,
    <http://ns.inria.fr/iadas/sport-vocab/softball>, <http://ns.inria.fr/iadas/sport-vocab/tennis>,
    <http://ns.inria.fr/iadas/sport-vocab/track%20sprints>, <http://ns.inria.fr/iadas/sport-vocab/track%20throws>;
  iadas:limites "Sample size of the study. The athletes came from the same institutions. Study did not collect detailed dietary information, such as macronutrient composition, we did use validated methods of interpreting athletes eating attitudes and behaviors. No causal relationship between perfectionism and our outcomes could be established because this was a cross-sectional study. ";
  iadas:numberOfSportStudied "Multiple";
  iadas:perspectives "Future research should investigate possible interventions to hemp athletes manifest their perfectionistic tendencies in adaptive dimensions rather than maladaptive dimensions associated with an increased risk. Other psychological variables (drive for thinness, self esteem) should also benefit explored to further our understanding of the role of mental health in athletes risk for adverse health conditions. ";
  iadas:relationDegree "r=.11, N.S.";
  iadas:relationDirection "NS";
  iadas:sampleSizeMobilized "25";
  iadas:sportPracticeType "Mixed sport";
  iadas:sportSubcategory "Multisport ";
  iadas:typeOfAnalysis "Correlation" .

