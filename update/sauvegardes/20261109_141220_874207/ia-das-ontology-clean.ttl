<http://ns.inria.fr/iadas/data/Analysis_2154> a iadas:Analysis;
  iadas:analysisId "2154";
  iadas:authorConclusion "Societal pressures mediated by internalisation, are associated with binge eating and bulimia, while body dissatisfaction leads to bulimia and binge eating, mediated by negative affect. ";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_2154>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_2154>;
  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/Swimming>, <http://ns.inria.fr/iadas/sport-vocab/basketball>,
    <http://ns.inria.fr/iadas/sport-vocab/boxing>, <http://ns.inria.fr/iadas/sport-vocab/cycling>,
    <http://ns.inria.fr/iadas/sport-vocab/dancing>, <http://ns.inria.fr/iadas/sport-vocab/equestrian>,
    <http://ns.inria.fr/iadas/sport-vocab/football>, <http://ns.inria.fr/iadas/sport-vocab/golf>,
    <http://ns.inria.fr/iadas/sport-vocab/orienteering>, <http://ns.inria.fr/iadas/sport-vocab/ping-pong>,
    <http://ns.inria.fr/iadas/sport-vocab/race%20walking>, <http://ns.inria.fr/iadas/sport-vocab/rowing>,
    <http://ns.inria.fr/iadas/sport-vocab/rugby>, <http://ns.inria.fr/iadas/sport-vocab/tennis>,
    <http://ns.inria.fr/iadas/sport-vocab/track%20and%20field>, <http://ns.inria.fr/iadas/sport-vocab/volleyball>;
  iadas:limites "Cross sectional nature. None of the measurements scale were specifically designed for athletes. The scale for social media usage and modelled behaviours were purpose-built. for this study and thus were not formally validated in previous research and so had lower Cronbach alpha coefficients than would normally be acceptable. This research is limited in its ability to make sound assumptions on clinical implications. ";
  iadas:numberOfSportStudied "Multiple";
  iadas:perspectives "Future research should use a longitudinal design to determine whether the relevant factors are able to predict future disordered eating in an athlete sample. Repeated this research with athletes younger than 18 years old would also provide additional insight as it is a high risk population for the development of eating disorders. A qualitative investigation to further understand the differences between the original etiological model and the revised model will also be undertaken. ";
  iadas:relationDegree "r=-.020, N.S.";
  iadas:relationDirection "NS";
  iadas:sampleSizeMobilized "1017";
  iadas:sportPracticeType "Mixed sport";
  iadas:sportSubcategory "Multisport ";
  iadas:typeOfAnalysis "Correlation" .

