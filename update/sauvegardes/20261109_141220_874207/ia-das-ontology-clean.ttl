  iadas:authorConclusion "Body shape concerns in pubertal rhythmic gymnasts are associated with disordered eating attitudes and maladaptive perfectionism, increasing vulnerability to eating disorders.";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_1238>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_1238>;
  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/Rhythmic%20gymnastics>;
  iadas:limites "The study is limited by a small, specific sample, self-reported data, and a cross-sectional design without a control group. These factors restrict generalizability and prevent causal conclusions";
  iadas:numberOfSportStudied "One";
  iadas:perspectives "Future research should include larger and more diverse samples and use longitudinal designs, especially during puberty. Early interventions targeting body image and perfectionism could help reduce eating disorder risk";
  iadas:relationDegree "r=.511, p<.01";
  iadas:relationDirection "+";
  iadas:sampleSizeMobilized "40";
  iadas:sportPracticeType "Individual sport";
  iadas:sportSubcategory "Aesthetic";
  iadas:typeOfAnalysis "Pearson correlation" .

