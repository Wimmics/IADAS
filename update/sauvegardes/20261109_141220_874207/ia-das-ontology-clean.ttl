<http://ns.inria.fr/iadas/data/Analysis_1480> a iadas:Analysis;
  iadas:analysisId "1480";
  iadas:authorConclusion "Correlates of DE that may be used as halth warnings for young dancers include perfectionism and, for Females, excessives exercising outside of dance, sleep disturbances, and malestrual dysfunction. ";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_1480>;
