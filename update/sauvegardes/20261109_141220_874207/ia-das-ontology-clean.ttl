<http://ns.inria.fr/iadas/data/Analysis_878> a iadas:Analysis;
  iadas:analysisId "878";
  iadas:authorConclusion "High standards and self criticism are positively associated with eating restraint, eating concern, weight concern and shape concern. The associations between self-criticism and eating pathology were not moderated by high standards. Self criticism fully mediated the relationships between high standards and restraint, eating concern, weight concern and shape concern. ";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_878>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_878>;
  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/Dance%20%28ballet%29>, <http://ns.inria.fr/iadas/sport-vocab/Dance%20%28hip%20hop%29>,
    <http://ns.inria.fr/iadas/sport-vocab/Dance%20%28jazz%29>, <http://ns.inria.fr/iadas/sport-vocab/Dance%20%28modern%29>,
    <http://ns.inria.fr/iadas/sport-vocab/Dance%20%28other%29>, <http://ns.inria.fr/iadas/sport-vocab/Dance%20%28tap%29>,
    <http://ns.inria.fr/iadas/sport-vocab/contemporary%20dance>;
  iadas:limites "The self report nature of the data means reports may be unreliable and subject to social desirability bias. The method of participants recruitlent precluded any analysis of response rate, and it was not known whether or not there was a bias to those who chose to participate versus those who did not participate. The heterogeneous nature of the sample means that underlying group differences (between dance style, competency level and hours of dance practice) may have been missed. ";
  iadas:numberOfSportStudied "One";
  iadas:perspectives "The relationships between high standards, self-criticism and eating disorder risk requires examination in more homogenous sub-groups of dancers, to further identify the risk environments for eating psychopathology. ";
  iadas:relationDegree "r=.11, p>.05";
  iadas:relationDirection "NS";
  iadas:sampleSizeMobilized "244";
  iadas:sportPracticeType "Individual sport";
  iadas:sportSubcategory "Aesthetic";
  iadas:typeOfAnalysis "Correlation" .

