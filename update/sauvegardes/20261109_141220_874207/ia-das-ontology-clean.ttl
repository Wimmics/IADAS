<http://ns.inria.fr/iadas/data/Analysis_2090> a iadas:Analysis;
  iadas:analysisId "2090";
  iadas:authorConclusion "Despite engaging in dieting and rapid weight loss, athletes showed relatively low levels of disordered eating, though perfectionism especially maladaptive was associated with these symptoms. Coaches and peers played a key role in shaping weight management behaviors";
  iadas:complexityOfAnalysis "Simple analyses";
  iadas:groupStatisticalAnalysis "Correlation";
  iadas:hasPopulation <http://ns.inria.fr/iadas/data/Population_2090>;
  iadas:hasRelation <http://ns.inria.fr/iadas/data/Relations_2090>;
  iadas:hasSport <http://ns.inria.fr/iadas/sport-vocab/Brazilian%20jiu-jitsu>, <http://ns.inria.fr/iadas/sport-vocab/Kickboxing>;
  iadas:limites "The small, single-city sample and cross-sectional design limit generalizability and prevent causal conclusions. Additionally, some measures (e.g., translated scales) were not fully validated";
  iadas:numberOfSportStudied "Multiple";
  iadas:perspectives "Future research should use larger samples to better assess disordered eating prevalence in combat sports and explore the role of perfectionism and sport regulations. This could help improve athlete education and safer weight management practices";
  iadas:relationDegree "r=.555, p<.01";
  iadas:relationDirection "+";
  iadas:sampleSizeMobilized "46";
  iadas:sportPracticeType "Individual sport";
  iadas:sportSubcategory "Weight sensitive";
  iadas:typeOfAnalysis "Pearson correlation" .

