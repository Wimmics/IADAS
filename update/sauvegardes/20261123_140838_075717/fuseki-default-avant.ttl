<http://ns.inria.fr/iadas/data/Relations_180>
        a       <http://ns.inria.fr/iadas/ontology/Relations>;
        <http://ns.inria.fr/iadas/ontology/effectSize>
                "strong";
        <http://ns.inria.fr/iadas/ontology/hasDependentVariable>
                <http://ns.inria.fr/iadas/data/Variable_VD_180>;
        <http://ns.inria.fr/iadas/ontology/hasIndependentVariable>
                <http://ns.inria.fr/iadas/data/Variable_VI_180>;
