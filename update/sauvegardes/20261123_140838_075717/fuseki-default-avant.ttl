<http://ns.inria.fr/iadas/data/Analysis_1850>
        a       <http://ns.inria.fr/iadas/ontology/Analysis>;
        <http://ns.inria.fr/iadas/ontology/analysisId>
                "1850";
        <http://ns.inria.fr/iadas/ontology/authorConclusion>
                "We observed an overall, negative linear relationship between self regulatory eating attitudes and disordered eating in the sports contexts. The overall relationship between self regulatory eating attitudes and disordered eating was not totally linear. ";
        <http://ns.inria.fr/iadas/ontology/complexityOfAnalysis>
                "Simple analyses";
        <http://ns.inria.fr/iadas/ontology/groupStatisticalAnalysis>
                "Correlation";
        <http://ns.inria.fr/iadas/ontology/hasPopulation>
