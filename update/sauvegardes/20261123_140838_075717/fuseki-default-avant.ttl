<http://ns.inria.fr/iadas/sport-vocab/Jiu-jitsu>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Weight_class>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Martial_arts>;
        skos:description  "Ancestral Japanese martial art, grouping together combat techniques developed by the samurai to defend themselves when they were unarmed. These techniques are sometimes classified into five main categories: atemi-waza: striking techniques; nage-waza: throwing techniques; ne-waza: ground techniques; kansetsu-waza: arthralgic techniques (injuring joints); shime-waza: strangulation techniques; Kuatsu: ‘return to life’ or ‘resuscitation’ technique; Kyusho: technique of the vital points of the human body.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Jiu-jitsu" .

<http://ns.inria.fr/iadas/sport-vocab/Jogging>
