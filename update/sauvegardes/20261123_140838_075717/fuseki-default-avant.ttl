<http://ns.inria.fr/iadas/sport-vocab/Rowing_heavyweight>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Endurance>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Rowing>;
        skos:description  "Category of athletes who compete with no weight restriction, as opposed to lightweight. This specialty includes rowers whose body mass may be high, enabling them to develop maximum power during races. Heavyweight competitions include various boat classes such as the single scull, coxless pair, coxless four, or eight.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Rowing heavyweight" .

<http://ns.inria.fr/iadas/sport-vocab/Rowing_lightweight>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Endurance>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Rowing>;
        skos:description  "Olympic rowing category introduced at the Atlanta Games in 1996. This specialty is distinguished by precise weight restrictions: for women, each athlete must not exceed 59 kg, and the crew’s average weight cannot exceed 57 kg. For men, the individual limit is set at 72.5 kg, with a crew average maximum of 70 kg. These constraints ensure balanced competition among lighter rowers while maintaining the high physical, technical, and strategic demands of high-level rowing.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Rowing lightweight" .

<http://ns.inria.fr/iadas/sport-vocab/Rugby>
