<http://ns.inria.fr/iadas/data/Analysis_2010>
        a       <http://ns.inria.fr/iadas/ontology/Analysis>;
        <http://ns.inria.fr/iadas/ontology/analysisId>
                "2010";
        <http://ns.inria.fr/iadas/ontology/authorConclusion>
                "Self critical perfectionism was found as the salient predictor of athletes eating psychopathology. Personal standards perfectionism was positively correlated with athletes eating psychopathology. Gender significantly moderate association between personal standards perfectionism and eating psychopathology, with the positive relationship found to be significant for Female athletes only. The findings revealed the relationship between self critical perfectionism and eating psychopathology to be of relevance only to Female athletes. ";
        <http://ns.inria.fr/iadas/ontology/complexityOfAnalysis>
                "Simple analyses";
        <http://ns.inria.fr/iadas/ontology/groupStatisticalAnalysis>
                "Correlation";
        <http://ns.inria.fr/iadas/ontology/hasPopulation>
