<http://ns.inria.fr/iadas/sport-vocab/Brazilian_jiu-jitsu>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Weight_class>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Martial_arts>;
        skos:description  "Brazilian Jiu-Jitsu is a grappling martial art focused on ground fighting and submission techniques. It allows a smaller or weaker practitioner to control and defeat a larger opponent through technique, leverage, and positional strategy.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Brazilian jiu-jitsu" .

