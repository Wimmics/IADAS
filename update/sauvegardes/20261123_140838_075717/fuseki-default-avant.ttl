<http://ns.inria.fr/iadas/data/Analysis_487>
        a       <http://ns.inria.fr/iadas/ontology/Analysis>;
        <http://ns.inria.fr/iadas/ontology/analysisId>
                "487";
        <http://ns.inria.fr/iadas/ontology/authorConclusion>
                "This study shows that negative coaching styles are associated with disordered eating through increased self-criticism, while positive leadership styles help reduce self-criticism. It highlights self-criticism as a key psychological mechanism linking coaching behaviors to eating pathology.";
        <http://ns.inria.fr/iadas/ontology/complexityOfAnalysis>
                "Simple analyses";
        <http://ns.inria.fr/iadas/ontology/groupStatisticalAnalysis>
                "Correlation";
