<http://ns.inria.fr/iadas/sport-vocab/Gymnastics_tumbling>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Gymnastics>;
        skos:description  "A discipline in which gymnasts perform a series of acrobatics on a dynamic track. The Tumbling track is 25 meters long and 2 meters wide. Gymnasts must perform a sequence of 8 consecutive acrobatic moves, ending with a \"dismount.\" The landing area measures 6 meters by 4 meters.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Gymnastics tumbling" .

<http://ns.inria.fr/iadas/sport-vocab/Rythmic_gymnastics>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Gymnastics>;
        skos:description  "Sport practised to music using apparatus: hoop, ball, clubs, ribbon and rope. In competition, it can be practised either individually or in a group of 5 gymnasts. It is a complete discipline combining flexibility, grace and skill.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Rythmic gymnastics" .

<http://ns.inria.fr/iadas/sport-vocab/Trampoline_gymnastics>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Gymnastics>;
        skos:description  "An acrobatic discipline that can be practiced individually or in pairs (called synchronized). Gymnasts perform on a trampoline measuring 4 meters by 2 meters, positioned 1.15 meters above the ground. 120 springs surrounding the trampoline allow the gymnasts to reach a height of up to 8 meters. The exercises consist of 10 trampoline touches, during which gymnasts can perform numerous acrobatic moves (jumps, flips, twists, etc.). These acrobatics must be performed in succession.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Trampoline gymnastics" .

