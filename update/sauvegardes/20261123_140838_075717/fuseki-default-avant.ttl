                "Female";
        <http://ns.inria.fr/iadas/ontology/hasStatistics>
                <http://ns.inria.fr/iadas/data/AgeStats_1062> , <http://ns.inria.fr/iadas/data/BmiStats_1062> , <http://ns.inria.fr/iadas/data/ExFreqStats_1062> , <http://ns.inria.fr/iadas/data/ExpStats_1062>;
