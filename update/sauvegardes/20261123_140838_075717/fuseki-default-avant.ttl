        <http://ns.inria.fr/iadas/ontology/relationDegree>
                "Supportive friendship-self esteem 𝛃=1.50, p<.01\nSelf esteem-drive for thinness 𝛃=-.10, p<.05\nSupportive friendship-drive for thinness total effect 𝛃=-.72, p<.05\nSupportive friendship-drive for thinness direct effect 𝛃=-.57, p=.11";
        <http://ns.inria.fr/iadas/ontology/relationDirection>
                "NA";
        <http://ns.inria.fr/iadas/ontology/sampleSizeMobilized>
                "195";
        <http://ns.inria.fr/iadas/ontology/sportPracticeType>
                "Mixed sport";
        <http://ns.inria.fr/iadas/ontology/typeOfAnalysis>
                "Regression model " .

