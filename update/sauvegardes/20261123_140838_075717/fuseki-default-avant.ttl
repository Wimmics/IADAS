        a       <http://ns.inria.fr/iadas/ontology/Population>;
        <http://ns.inria.fr/iadas/ontology/gender>
                "Male";
        <http://ns.inria.fr/iadas/ontology/hasStatistics>
                <http://ns.inria.fr/iadas/data/AgeStats_16> , <http://ns.inria.fr/iadas/data/BmiStats_16> , <http://ns.inria.fr/iadas/data/ExFreqStats_16> , <http://ns.inria.fr/iadas/data/ExpStats_16>;
