        <http://ns.inria.fr/iadas/ontology/gender>
                "Male";
        <http://ns.inria.fr/iadas/ontology/hasStatistics>
                <http://ns.inria.fr/iadas/data/AgeStats_18> , <http://ns.inria.fr/iadas/data/BmiStats_18> , <http://ns.inria.fr/iadas/data/ExFreqStats_18> , <http://ns.inria.fr/iadas/data/ExpStats_18>;
