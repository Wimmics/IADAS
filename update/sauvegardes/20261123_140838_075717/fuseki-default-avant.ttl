<http://ns.inria.fr/iadas/data/Analysis_1188>
        a       <http://ns.inria.fr/iadas/ontology/Analysis>;
        <http://ns.inria.fr/iadas/ontology/analysisId>
                "1188";
        <http://ns.inria.fr/iadas/ontology/authorConclusion>
                "Teammates and the uniform pressure and self-concept of strength were associated with higher ED symptoms in female rowers, whereas better self-concept, psychological well-being and more age showed less susceptibility of ED symptoms. ";
        <http://ns.inria.fr/iadas/ontology/complexityOfAnalysis>
                "Complex analyses";
        <http://ns.inria.fr/iadas/ontology/groupStatisticalAnalysis>
                "Regression";
        <http://ns.inria.fr/iadas/ontology/hasPopulation>
