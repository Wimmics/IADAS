        <http://ns.inria.fr/iadas/ontology/analysisId>
                "634";
        <http://ns.inria.fr/iadas/ontology/authorConclusion>
                "Emotion regulation plays a significant role in eating disorder risk among young athletes, with emotional suppression acting as a risk factor and cognitive reappraisal as a protective factor. Adolescence appears to be a critical period for these associations.";
        <http://ns.inria.fr/iadas/ontology/complexityOfAnalysis>
                "Simple analyses";
        <http://ns.inria.fr/iadas/ontology/groupStatisticalAnalysis>
                "Correlation";
