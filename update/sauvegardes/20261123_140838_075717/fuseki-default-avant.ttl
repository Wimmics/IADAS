        <http://ns.inria.fr/iadas/ontology/analysisId>
                "1328";
        <http://ns.inria.fr/iadas/ontology/authorConclusion>
                "Regression analyses for females revealed that body dissatisfaction was the most strongly related variable to disordered eating behaviors, followed by self esteem and type of sport. The regression analysis revealed that for males, body dissatisfaction was the only variable that related to disordered eating behavior. ";
        <http://ns.inria.fr/iadas/ontology/complexityOfAnalysis>
                "Simple analyses";
        <http://ns.inria.fr/iadas/ontology/groupStatisticalAnalysis>
                "Correlation";
