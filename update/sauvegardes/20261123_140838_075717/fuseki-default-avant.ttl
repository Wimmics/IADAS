        <http://ns.inria.fr/iadas/ontology/gender>
                "Female";
        <http://ns.inria.fr/iadas/ontology/hasStatistics>
                <http://ns.inria.fr/iadas/data/AgeStats_219> , <http://ns.inria.fr/iadas/data/BmiStats_219> , <http://ns.inria.fr/iadas/data/ExFreqStats_219> , <http://ns.inria.fr/iadas/data/ExpStats_219>;
