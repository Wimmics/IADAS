<http://ns.inria.fr/iadas/sport-vocab/Figure_skating_ice_dancing>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Figure_skating>;
        skos:description  "It is a discipline close to pair figure skating. The skaters should not give the impression of skating but of dancing on ice, often in synchronization with their partner.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Figure skating ice dancing" .

<http://ns.inria.fr/iadas/sport-vocab/Figure_skating_pairs>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Figure_skating>;
        skos:description  "The discipline of ice dance pairs stands out from ice dancing by many overhead lifts held at arm’s length above the boy’s head, the famous 'death spiral,' and throw jumps.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Figure skating pairs" .

<http://ns.inria.fr/iadas/sport-vocab/Figure_skating_synchronized>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Figure_skating>;
        skos:description  "Team sport with 8 to 20 skaters. The goal is to perform figures such as blocks, wheels, and intersections in a perfectly synchronized, smooth, and harmonious way to the rhythm of music.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Figure skating synchronized" .

<http://ns.inria.fr/iadas/sport-vocab/Roller-skate_figure_skating>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Figure_skating>;
        skos:description  "A sport discipline performed with quad roller skates on a smooth and flat surface measuring at least 20 x 40 meters (parquet, smooth concrete, terrazzo, etc.). It can be practiced individually or in pairs. This is a technical and acrobatic discipline that requires speed, power, precision, and artistic expression. Athletes can compete in compulsory figures or free skating.\nEach event is judged separately. An athlete participating in both events will also receive a combined ranking.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Roller-skate figure skating" .

<http://ns.inria.fr/iadas/sport-vocab/Floorball>
