        <http://ns.inria.fr/iadas/ontology/gender>
                "Male";
        <http://ns.inria.fr/iadas/ontology/hasStatistics>
                <http://ns.inria.fr/iadas/data/AgeStats_20> , <http://ns.inria.fr/iadas/data/BmiStats_20> , <http://ns.inria.fr/iadas/data/ExFreqStats_20> , <http://ns.inria.fr/iadas/data/ExpStats_20>;
