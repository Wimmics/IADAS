                "979";
        <http://ns.inria.fr/iadas/ontology/authorConclusion>
                "After controlling for social desirability effects, negative perfectionism scores were found to correlate positively with disturbed eating attitudes scores, whereas positive perfectionism scores were found to be unrelated to disturbed eating attitude scores. ";
        <http://ns.inria.fr/iadas/ontology/complexityOfAnalysis>
                "Complex analyses";
        <http://ns.inria.fr/iadas/ontology/groupStatisticalAnalysis>
                "Regression";
