<http://ns.inria.fr/iadas/sport-vocab/Acrobatic_gymnastic>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Gymnastics>;
        skos:description  "A sport that combines acrobatics and choreography performed individually and collectively, to music. Pyramids are the special feature of this discipline. It requires strength, flexibility, agility and acrobatic skills. The exercises are performed on a platform similar to that used in artistic gymnastics.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Acrobatic gymnastic" .

<http://ns.inria.fr/iadas/sport-vocab/Gymnastics>
        a               skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:inScheme   <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:narrower   <http://ns.inria.fr/iadas/sport-vocab/Acrobatic_gymnastic> , <http://ns.inria.fr/iadas/sport-vocab/Aerobic_gymnastic> , <http://ns.inria.fr/iadas/sport-vocab/Artistic_gymnastic> , <http://ns.inria.fr/iadas/sport-vocab/Gymnastics_tumbling> , <http://ns.inria.fr/iadas/sport-vocab/Rythmic_gymnastics> , <http://ns.inria.fr/iadas/sport-vocab/Trampoline_gymnastics>;
        skos:prefLabel  "Gymnastics" .

<http://ns.inria.fr/iadas/sport-vocab/Acrobatic_skiing>
        a               skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Technical>;
        skos:inScheme   <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel  "Acrobatic skiing" .

<http://ns.inria.fr/iadas/sport-vocab/Aerobic_classes>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Fitness>;
        skos:description  "A discipline combining fitness and acrobatics. It allows you to demonstrate your ability to perform a series of dynamic movements to music. A truly creative discipline, it requires you to capture the audience's attention and harmoniously combine dance elements with elements of difficulty. Movements can be performed individually, in duets, trios or groups (5 gymnasts).";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Aerobic classes" .

<http://ns.inria.fr/iadas/sport-vocab/Aerobic_endurance_training>
        a               skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Endurance>;
        skos:inScheme   <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel  "Aerobic endurance training" .

<http://ns.inria.fr/iadas/sport-vocab/Aerobic_gymnastic>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Gymnastics>;
        skos:description  "A discipline combining fitness and acrobatics. It requires strength, endurance, and flexibility. Gymnasts perform to music lasting 1 minute 30 seconds on a surface of 7 x 7 meters for individuals, and 10 x 10 meters for groups. The movements can be performed individually, in pairs, in trios, or in groups (5 gymnasts).";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Aerobic gymnastic" .

<http://ns.inria.fr/iadas/sport-vocab/Aerobics>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Fitness>;
        skos:description  "Aerobic exercise is a type of sustained exercise that mainly depends on energy generation via aerobic metabolism and provides cardiovascular conditioning, like running, swimming, and cycling.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Aerobics" .

