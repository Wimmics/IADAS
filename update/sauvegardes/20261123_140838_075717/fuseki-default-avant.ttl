<http://ns.inria.fr/iadas/data/Analysis_949>
        a       <http://ns.inria.fr/iadas/ontology/Analysis>;
        <http://ns.inria.fr/iadas/ontology/analysisId>
                "949";
        <http://ns.inria.fr/iadas/ontology/authorConclusion>
                "After controlling for social desirability effects, negative perfectionism scores were found to correlate positively with disturbed eating attitudes scores, whereas positive perfectionism scores were found to be unrelated to disturbed eating attitude scores. ";
        <http://ns.inria.fr/iadas/ontology/complexityOfAnalysis>
                "Simple analyses";
        <http://ns.inria.fr/iadas/ontology/groupStatisticalAnalysis>
                "Correlation";
        <http://ns.inria.fr/iadas/ontology/hasPopulation>
                <http://ns.inria.fr/iadas/data/Population_949>;
        <http://ns.inria.fr/iadas/ontology/hasRelation>
                <http://ns.inria.fr/iadas/data/Relations_949>;
        <http://ns.inria.fr/iadas/ontology/hasSport>
                <http://ns.inria.fr/iadas/sport-vocab/Rowing_%28i.e.%2C_Heavyweight_and_lightweight_rowing%29>;
        <http://ns.inria.fr/iadas/ontology/limites>
                "Focus only on rowing sample. ";
        <http://ns.inria.fr/iadas/ontology/numberOfSportStudied>
                "One";
        <http://ns.inria.fr/iadas/ontology/perspectives>
                "This would suggest that resiliency against unhealthy eating could be increased by teaching athletes how to develop and maintain high levels of positive perfectionism. Intervention with goal in mind is a worthy topic for future research. \nDo these perfectionistic tendencies change throughout an athlete's career ? How and why do these changes occur ? What implications do these changes have on eating attitude ?";
        <http://ns.inria.fr/iadas/ontology/relationDegree>
                " r=-.17, p<.01";
        <http://ns.inria.fr/iadas/ontology/relationDirection>
                "-";
        <http://ns.inria.fr/iadas/ontology/sampleSizeMobilized>
                "496";
        <http://ns.inria.fr/iadas/ontology/sportPracticeType>
                "Individual sport";
        <http://ns.inria.fr/iadas/ontology/typeOfAnalysis>
                "Bivariate correlation" .

<http://ns.inria.fr/iadas/data/Population_949>
        a       <http://ns.inria.fr/iadas/ontology/Population>;
        <http://ns.inria.fr/iadas/ontology/gender>
                "Mixed";
        <http://ns.inria.fr/iadas/ontology/hasStatistics>
                <http://ns.inria.fr/iadas/data/AgeStats_949> , <http://ns.inria.fr/iadas/data/BmiStats_949> , <http://ns.inria.fr/iadas/data/ExFreqStats_949> , <http://ns.inria.fr/iadas/data/ExpStats_949>;
