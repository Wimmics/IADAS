<http://ns.inria.fr/iadas/sport-vocab/Circus>
        a               skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:altLabel   "Floor acrobatics";
        skos:inScheme   <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:narrower   <http://ns.inria.fr/iadas/sport-vocab/Circus_acrobatic> , <http://ns.inria.fr/iadas/sport-vocab/Circus_equilibrium> , <http://ns.inria.fr/iadas/sport-vocab/Circus_object_manipulation>;
        skos:prefLabel  "Circus" .

<http://ns.inria.fr/iadas/sport-vocab/Circus_acrobatic>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:altLabel     "Floor acrobatics";
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Circus>;
        skos:description  "It is a mix of acrobatics and choreographies performed individually and collectively to music. It is a physical activity similar to acrobatic gymnastics.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Circus acrobatic" .

<http://ns.inria.fr/iadas/sport-vocab/Circus_equilibrium>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Circus>;
        skos:description  "The exercises of balance artists consist either in keeping their body still while positioned unstably, or in maintaining stable objects stacked in an apparently fragile manner. Includes events such as Rolla Bolla, balance ball, stilts, unicycles, slackline, and tightrope.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Circus equilibrium" .

<http://ns.inria.fr/iadas/sport-vocab/Circus_object_manipulation>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Circus>;
        skos:description  "Artistic and physical practice that involves skillfully manipulating objects such as balls, clubs, or rings. It requires coordination, dexterity, and concentration, and is often performed solo or in groups as part of circus acts or street performances.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Circus object manipulation" .

