<http://ns.inria.fr/iadas/sport-vocab/Dance_African>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Dance>;
        skos:description  "Dance combining rhythm and movement. Characterized by rites, magic, enchantment, exorcism, and the expression of freedom, morality, and various emotions. In Africa, no dance is performed without a specific purpose.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Dance African" .

<http://ns.inria.fr/iadas/sport-vocab/Dance_Irish>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Dance>;
        skos:description  "Traditional dance style from Ireland, characterized by quick footwork and a stiff upper body.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Dance Irish" .

<http://ns.inria.fr/iadas/sport-vocab/Dance_Kathak>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Dance>;
        skos:description  "A rhythmic and energetic dance form from northern India. It represents a fusion of Hindu and Muslim cultures, characterized by powerful footwork.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Dance Kathak" .

<http://ns.inria.fr/iadas/sport-vocab/Dance_ballet>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Dance>;
        skos:description  "A type of dancing where carefully organized movements tell a story or express an idea, or a theatre work that uses this type of dancing: Dancers often wear elaborate costumes and pointe shoes, which allow them to dance on the tips of their toes.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Dance ballet" .

<http://ns.inria.fr/iadas/sport-vocab/Dance_classical>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Dance>;
        skos:description  "Dance based on the principle of turnout and the five positions of the feet and arms, which was taught in the classes of the Royal Academy of Dance.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Dance classical" .

<http://ns.inria.fr/iadas/sport-vocab/Dance_contemporary>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Dance>;
        skos:description  "This dance is created based on classical dance, with added improvisation and freedom of movement for the dancer. It involves a strong connection to the floor and features an abstract form of storytelling.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Dance contemporary" .

<http://ns.inria.fr/iadas/sport-vocab/Dance_flamenco>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Dance>;
        skos:description  "Spanish folk dance. It is a solo dance style characterized by its fusion with singing, hand clapping, and percussive footwork (similar to tap dancing). This dance can be accompanied by castanets. There is a traditional costume. For women, it consists of high-heeled shoes, a long, colorful dress (often red and black or white with polka dots) adorned with ruffles, as well as a fringed shawl. For men, it involves a short Andalusian suit.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Dance flamenco" .

<http://ns.inria.fr/iadas/sport-vocab/Dance_hip_hop>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Dance>;
        skos:description  "Hip-hop culture brings together graffiti, DJing, rap, and urban dances such as breakdance, locking, and popping.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Dance hip hop" .

<http://ns.inria.fr/iadas/sport-vocab/Dance_jazz%2Fmodern>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Dance>;
        skos:description  "Dance that emphasizes torso mobility, parallel feet, stylistic individuality, and improvisation, combining sensuality, acrobatics, and dynamic expressiveness.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Dance jazz/modern" .

<http://ns.inria.fr/iadas/sport-vocab/Dance_musical_theater>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Dance>;
        skos:description  "It is a blend of dance, theatre, and music, featuring narrative and scenic interpretation.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Dance musical theater" .

<http://ns.inria.fr/iadas/sport-vocab/Dance_neoclassic>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Dance>;
        skos:description  "Choreographic composition design in which dance takes precedence over music and scenery.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Dance neoclassic" .

<http://ns.inria.fr/iadas/sport-vocab/Dance_spanish_folk>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Dance>;
        skos:description  "Traditional folk dance, originating in rural or village contexts, passed down orally, resulting in variations depending on the region or performers.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Dance spanish folk" .

<http://ns.inria.fr/iadas/sport-vocab/Dance_tap>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Dance>;
        skos:description  "Type of dance in which the rhythm is kept by the noise of the dancer's shoes on the floor.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Dance tap" .

<http://ns.inria.fr/iadas/sport-vocab/Urban_dance>
        a                 skos:Concept , <http://ns.inria.fr/iadas/ontology/Sport>;
        <http://ns.inria.fr/iadas/ontology/sportCategory>
                <http://ns.inria.fr/iadas/sport-category-vocab/Aesthetic>;
        skos:broader      <http://ns.inria.fr/iadas/sport-vocab/Dance>;
        skos:description  "It is a street dance practiced in the form of duels called battles, where dancers compete by performing sequences of footwork and floor moves.";
        skos:inScheme     <http://ns.inria.fr/iadas/sport-category-vocab/Sport>;
        skos:prefLabel    "Urban dance" .

