    rr:subjectMap [ rr:class skos:Concept ;
            rr:template "http://ns.inria.fr/iadas/ACAD-vocab/{sub-class 3}" ] .

<http://ns.inria.fr/iadas/ACAD-vocab/#VariableSubClass4> a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
