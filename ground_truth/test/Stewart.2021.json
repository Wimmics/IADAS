  "Analysis": [
    {
      "predicate": "iadas:typeOfAnalysis",
      "object": "Cross sectional correlations"
    },
    {
      "predicate": "iadas:authorConclusion",
      "object": "Daily life thin-fat others correlated with EDE-Q global scores. Sport muscularity did not correlated with EDE-Q. All dimensions except muscularity correlated with all subscales in both contexts. Appearance dimension (perceiving others opinions of yourself) was related to higher levels of ED pathology in both daily life and sport contexts. Self evaluation and perceived other evaluation as fatter were also related to more ED pathology. Muscularity in daily life was not related to ED symptomatology. CBIQA scores related to appearance may predict future ED pathology."
    },
    {
      "predicate": "iadas:limites",
      "object": "Reliance on self-report data, attrition at follow-up, and that the CBIQA was delivered to participants 12 months into the FAB program as opposed to the beginning of the parent trial."
