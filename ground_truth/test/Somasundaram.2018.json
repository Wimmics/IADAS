  "Analysis": [
    {
      "predicate": "iadas:typeOfAnalysis",
      "object": "Correlation"
    },
    {
      "predicate": "iadas:authorConclusion",
      "object": "Results indicated a moderate, positive and significant relationship between evaluative concerns and disordered eating. The associations of striving with the dimensions of eating psychopathology were both weak and one was non-significant. For each group, evaluative concerns was found to have a significant, positive association with the EAT and EDI-BD. Team/individuals athletes have significant positive associations between evaluative concerns and eating/body attitudes while aesthetic athletes had non-significant association between these variables. Regarding striving, team/indivdiual athletes maintained marginally-significant relationships between this dimension of perfectionism and the EAT, while aesthetic athletes maintained a non-significant association between the two variables. There is no relationship between striving and body dissatisfaction for team/indivdiual athletes. Aesthetic athletes displayed a significant negative association between striving and EDI-BD."
    },
    {
      "predicate": "iadas:limites",
      "object": "The data was collected exclusively at colleges with an NCAA Division III program. This lower level of competition may have affected the results. The sample size was small."
    },
    {
      "predicate": "iadas:perspectives",
      "object": "Future studies may replicate the current methods aong a more competitive population as the degree of competitiveness enforced and internalized by athletes has been highlighted as an important predictor for the development of maladaptive psychological symptoms."
    },
